// バージョン確認用デバッグコード - 前の修正が反映されているか確認
// より理解しやすくするために大きなメッセージを表示
const VERSION = '2025-04-19-v3';
console.log(`%c【現場ボイスアプリ】が最新バージョン${VERSION}で動作中です（フォルダ名修正版）`, 'font-size: 20px; color: green; background-color: yellow; padding: 5px;');

// 実行時に必ずこのコードが実行されることを確認するための関数
function initializeDebugHelpers() {
  // コンソールに大きな注意書きを表示
  console.log('%c【重要】このメッセージが表示されていれば、最新版のmain.jsが実行されています', 'font-size: 18px; color: red; background-color: black; padding: 10px;');
  
  // ページ読み込み後にデバッグ用の要素を追加
  const debugElement = document.createElement('div');
  debugElement.id = 'version-debug';
  debugElement.style.position = 'fixed';
  debugElement.style.top = '10px';
  debugElement.style.right = '10px';
  debugElement.style.backgroundColor = 'rgba(255, 255, 0, 0.7)';
  debugElement.style.padding = '5px';
  debugElement.style.zIndex = '9999';
  debugElement.innerHTML = `現場ボイスバージョン: ${VERSION}<br>フォルダ名: whisper-voice`;
  document.body.appendChild(debugElement);
}

// ページ読み込み後に実行
window.addEventListener('DOMContentLoaded', function() {
  initializeDebugHelpers();
});

const recordButton = document.getElementById('record-btn');
const recordingStatus = document.getElementById('status');
const imageInput = document.getElementById('imageInput');
const imagePreview = document.getElementById('imagePreview');
const reporterDisplay = document.getElementById('reporter'); // div
const shipNOInput = document.getElementById('ship-input'); // input
const blockInput = document.getElementById('block-input'); // input
const submitButton = document.getElementById('submit-btn');
const statusMessage = document.getElementById('statusMessage'); // 存在しない場合は適宜修正

let mediaRecorder;
let audioChunks = [];
let audioBlob = null;
let imageFile = null;
let isRecording = false;

// --- 音声録音関連 --- 
async function startRecording() {
    try {
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        mediaRecorder = new MediaRecorder(stream);

        mediaRecorder.ondataavailable = event => {
            audioChunks.push(event.data);
        };

        mediaRecorder.onstop = () => {
            audioBlob = new Blob(audioChunks, { type: 'audio/webm' });
            
            // 音声再生機能は不要のため削除
            console.log('録音完了：ファイルサイズ', audioBlob.size, 'bytes');
            
            audioChunks = []; // 次の録音のためにクリア
            checkFormCompletion(); // 録音完了で送信ボタンの状態を確認
            
            // 録音ストップ時にストリームを停止する
            stream.getTracks().forEach(track => track.stop());
        };
        
        // 録音が完了したことをコンソールに表示
        console.log('録音完了！音声データサイズ:', audioBlob ? audioBlob.size : 0, 'バイト');

        mediaRecorder.start();
        isRecording = true;
        recordButton.textContent = '録音停止';
        recordingStatus.textContent = '録音中...';
        // audioPlaybackへの参照を削除
        submitButton.disabled = true; // 録音中は送信不可
    } catch (err) {
        console.error('音声録音の初期化に失敗:', err);
        recordingStatus.textContent = 'エラー: マイクへのアクセスが許可されていません。';
    }
}

function stopRecording() {
    if (mediaRecorder && mediaRecorder.state === 'recording') {
        mediaRecorder.stop();
        isRecording = false;
        recordButton.textContent = '録音開始';
        recordingStatus.textContent = '停止中';
    }
}

recordButton.addEventListener('click', () => {
    if (isRecording) {
        stopRecording();
    } else {
        startRecording();
    }
});

// --- 画像関連 --- 
imageInput.addEventListener('change', (event) => {
    imageFile = event.target.files[0];
    if (imageFile) {
        const reader = new FileReader();
        reader.onload = (e) => {
            imagePreview.src = e.target.result;
            imagePreview.style.display = 'block';
        }
        reader.readAsDataURL(imageFile);
    } else {
        imagePreview.style.display = 'none';
        imagePreview.src = '#';
    }
    checkFormCompletion(); // 画像選択で送信ボタンの状態を確認
});

// --- フォーム入力値のチェック --- 
[shipNOInput, blockInput].forEach(input => {
    input.addEventListener('input', checkFormCompletion);
});
// reporterDisplayはdivなのでinputイベントは不要

function checkFormCompletion() {
    // reporterDisplayはdivなのでtextContentで判定
    // 必須項目は報告者名、船体番号、ブロック名のみ
    // 音声と画像は任意
    const isFormValid = reporterDisplay.textContent.trim() !== '' &&
                        shipNOInput.value.trim() !== '' &&
                        blockInput.value.trim() !== '';
    submitButton.disabled = !isFormValid || isRecording;
}

// --- 報告送信処理 --- 
async function processAndSendReport(audioBlob, imageFile, reporter, shipNO, block) {
    submitButton.disabled = true;
    recordButton.disabled = true;
    imageInput.disabled = true;

    try {
        let summary = '';
        let transcript = '';
        
        // 音声があれば处理
        if (audioBlob) {
            statusMessage.textContent = '処理中: 音声を文字起こししています...';
            const formData = new FormData();
            formData.append("audio", audioBlob, 'recording.webm');

            const whisperRes = await fetch("/api/whisper", { method: "POST", body: formData });
            if (!whisperRes.ok) {
                console.warn(`Whisper APIエラー: ${whisperRes.statusText} - テキスト手入力モードで続行します`);  
                // テキストデータを手動で入力してもらう
                const userText = prompt('レポート内容を入力してください:', '');
                if (!userText) {
                    throw new Error('レポート内容が入力されていません');
                }
                transcript = userText;
                summary = userText; // 要約なし
            } else {
                const data = await whisperRes.json();
                transcript = data.transcript;
                
                // 要約処理
                statusMessage.textContent = '処理中: 要約生成しています...';
                // 簡易版として固定リストを使用
                const COMPLETE_BLOCK_LIST = [
                    "BAA", "BOA", "BAF", "BOF", "B1", "B2", "B3", "B4", "B5", "B6", "B7", "B8", "B9", "B10", "B11", "B12",
                    "SA1", "SA1A", "SA1F", "SA2", "SA2C", "SA3", "SA3C",
                    "S1", "S2", "S3", "S4", "S5", "S6", "S7", "S8", "S9", "S10", "S11", "S12", "S13",
                    "AP1", "AP2", "AH2", "AH3", "L1", "L2", "D1", "D2",
                ];
                
                // グローバル変数として共有する
                window.COMPLETE_BLOCK_LIST = COMPLETE_BLOCK_LIST;
                
                // ページ読み込み完了後に要素を確認するグローバル関数
                window.checkBlockInputExists = function() {
                    console.log('ブロック入力欄の存在チェックを実行します');
                    const blockInput = document.getElementById('block-input');
                    if (blockInput) {
                        console.log('ブロック入力欄を確認: 存在します', blockInput);
                    } else {
                        console.error('ブロック入力欄を確認: 存在しません');
                        document.querySelectorAll('input').forEach((el, i) => {
                            console.log(`入力要素 ${i+1}: id=${el.id}, type=${el.type}, name=${el.name}`);
                        });
                    }
                }
                
                // ページ読み込み完了時にチェックを実行
                setTimeout(window.checkBlockInputExists, 1000);
                
                // ここが最も重要な部分 - 必ずこの完全なリストを使用する
                const fullBlocksList = window.COMPLETE_BLOCK_LIST;
                
                // 送信前に重要なブロック名が含まれているか確認
                const hasS5 = fullBlocksList.includes('S5');
                const hasS13 = fullBlocksList.includes('S13');
                console.log('%cブロックリスト確認: ' + fullBlocksList.length + '個の選択肢 | S5含む: ' + (hasS5 ? '✅' : '❌') + ' | S13含む: ' + (hasS13 ? '✅' : '❌'), 
                    'background: #222; color: ' + (hasS5 && hasS13 ? '#bada55' : '#ff5555') + '; font-size: 16px; padding: 5px;');

                // リクエスト送信前にブロックリストが正しいか確認
                if (!fullBlocksList.includes('S5') || !fullBlocksList.includes('S13')) {
                    console.warn('【重大警告】ブロックリストに重要なブロック名が含まれていません。不具合が生じる可能性があります。');
                    // 確実に完全なリストを再度設定
                    fullBlocksList = window.COMPLETE_BLOCK_LIST;
                }
                
                const summaryRes = await fetch("/api/summarize", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ 
                        text: transcript,
                        blocks: fullBlocksList  // 完全なブロックリストを確実に送信
                    })
                });
                
                // リクエストの詳細をログに記録
                console.log('【デバッグ】要約リクエスト詳細:', {
                    text: transcript,
                    blocks_count: fullBlocksList.length,
                    first_blocks: fullBlocksList.slice(0, 5),
                    last_blocks: fullBlocksList.slice(-5),
                    has_s13: fullBlocksList.includes('S13')
                });
                
                if (summaryRes.ok) {
                    const summaryData = await summaryRes.json();
                    summary = summaryData.summary;
                    
                    // 【完全に簡略化したブロック名設定処理】
                    if (summaryData.block) {
                        console.log('【重要】検出されたブロック名:', summaryData.block);
                        
                        try {
                            // 1. 必ず最初にブロック名をグローバル変数に保存
                            window.lastDetectedBlock = summaryData.block;
                            
                            // 2. DOM操作の直接的アプローチ - 単純な設定をまず実行
                            document.getElementById('block-input').value = summaryData.block;
                            
                            // 3. 可能な限りすべての方法で値を設定
                            if (blockInput) blockInput.value = summaryData.block;
                            
                            // 4. 入力フィールドの値を弾く - 強制的更新
                            const input = document.getElementById('block-input');
                            if (input) {
                                // 全てのイベントを弾く
                                input.dispatchEvent(new Event('input', { bubbles: true }));
                                input.dispatchEvent(new Event('change', { bubbles: true }));
                                input.dispatchEvent(new Event('focus', { bubbles: true }));
                                input.dispatchEvent(new Event('blur', { bubbles: true }));
                            }
                            
                            // 5. ブロック名を確実に入力欄に設定する - 完全な改善版
                            console.log('★★★ ブロック入力欄設定開始 ★★★');
                            console.log('検出されたブロック名:', summaryData.block);
                            
                            // ブロック入力欄を確実に特定するファンクション
                            function findBlockInput() {
                                // 試すべきすべてのセレクタのリスト
                                const selectors = [
                                    '#block-input', // メインのIDセレクタ
                                    'input[id="block-input"]', // IDを持つ入力要素
                                    'input[placeholder="ブロック名"]', // プレースホルダーで特定
                                    'label[for="block-input"] + input', // ラベルの次の入力要素
                                    '.form-group:has(label:contains(ブロック)) input', // ブロックラベルを含むform-group内の入力要素
                                ];
                                
                                // 各セレクタを試す
                                for (const selector of selectors) {
                                    try {
                                        const element = document.querySelector(selector);
                                        if (element) {
                                            console.log(`✅ セレクタが成功しました: ${selector}`);
                                            return element;
                                        }
                                    } catch (e) {
                                        console.warn(`セレクタエラー: ${selector}`, e);
                                    }
                                }
                                
                                // 必要な属性を持つ入力要素を探す
                                const allInputs = document.querySelectorAll('input[type="text"]');
                                console.log(`ドキュメント内のtext入力要素数: ${allInputs.length}`);
                                
                                // すべての入力要素をチェック
                                for (const input of allInputs) {
                                    // ブロックパターンの要素を探す
                                    const placeholder = input.placeholder?.toLowerCase() || '';
                                    const id = input.id?.toLowerCase() || '';
                                    const name = input.name?.toLowerCase() || '';
                                    const parentText = input.parentElement?.textContent?.toLowerCase() || '';
                                    
                                    if (
                                        id.includes('block') || 
                                        name.includes('block') || 
                                        placeholder.includes('ブロック') ||
                                        parentText.includes('ブロック')
                                    ) {
                                        console.log(`✅ 属性マッチにより要素が見つかりました:`, input);
                                        return input;
                                    }
                                }
                                
                                // 親要素スコープでの検索
                                const formGroups = document.querySelectorAll('.form-group, .input-group, .field');
                                for (const group of formGroups) {
                                    const labelText = group.querySelector('label')?.textContent || '';
                                    if (labelText.includes('ブロック')) {
                                        const input = group.querySelector('input');
                                        if (input) {
                                            console.log(`✅ 親グループラベルから要素が見つかりました:`, input);
                                            return input;
                                        }
                                    }
                                }
                                
                                // 全ての入力要素を記録してデバッグ表示
                                console.error('❗ どの方法でもブロック入力欄が見つかりません。入力要素一覧:');
                                document.querySelectorAll('input').forEach((el, i) => {
                                    console.log(`入力要素 ${i+1}: type=${el.type}, id=${el.id}, name=${el.name}, placeholder=${el.placeholder}`);
                                });
                                
                                return null;
                            }
                            
                            // ブロック入力欄を検索
                            const blockInputField = findBlockInput();
                            
                            // ブロック入力欄が見つかった場合
                            if (blockInputField) {
                                console.log('ブロック入力欄が見つかりました！ID:', blockInputField.id, ' 現在の値:', blockInputField.value);
                                
                                try {
                                    // 1. 直接値を設定
                                    blockInputField.value = summaryData.block;
                                    console.log('1. 直接値設定後:', blockInputField.value);
                                    
                                    // 2. 属性としても設定
                                    blockInputField.setAttribute('value', summaryData.block);
                                    
                                    // 3. フォーカスを当てる
                                    blockInputField.focus();
                                    
                                    // 4. イベントを発火させる
                                    blockInputField.dispatchEvent(new Event('input', { bubbles: true }));
                                    blockInputField.dispatchEvent(new Event('change', { bubbles: true }));
                                    console.log('4. イベント発火後:', blockInputField.value);
                                    
                                    // 5. DOM操作を部分的に遅延させる
                                    setTimeout(() => {
                                        // 再度確認して必要なら再設定
                                        if (blockInputField.value !== summaryData.block) {
                                            console.log('5. 再度設定中の値:', blockInputField.value);
                                            blockInputField.value = summaryData.block;
                                            blockInputField.dispatchEvent(new Event('input', { bubbles: true }));
                                            console.log('   再設定後:', blockInputField.value);
                                        }
                                    }, 200);
                                    
                                // 入力欄への設定は上のステップで既に行っているため、ここでの設定は不要
                                // ただし、表示整合性のために確認
                                if (blockInputElement.value !== summaryData.block) {
                                    console.log('ブロック欄の値が一致していないため再設定します');
                                    blockInputElement.value = summaryData.block || '';
                                }
                                
                                // ブロック名があれば最初のブロックタグを追加
                                if (summaryData.block) {
                                    const mainBlockTag = document.createElement('div');
                                    mainBlockTag.classList.add('block-tag', 'selected');
                                    mainBlockTag.textContent = summaryData.block;
                                    // クリックで選択できるようにする
                                    mainBlockTag.addEventListener('click', () => {
                                        blockInputElement.value = summaryData.block;
                                    });
                                    blockCandidateElement.appendChild(mainBlockTag);
                                    
                                    // 類似したブロック候補を表示
                                    const prefix = summaryData.block.charAt(0);
                                    const similarBlocks = COMPLETE_BLOCK_LIST
                                        .filter(block => block !== summaryData.block && block.startsWith(prefix))
                                        .slice(0, 3); // 最大3個まで
                                    
                                    // 類似ブロックを追加
                                    similarBlocks.forEach(block => {
                                        const blockTag = document.createElement('div');
                                        blockTag.classList.add('block-tag');
                                        blockTag.textContent = block;
                                        blockTag.addEventListener('click', () => {
                                            // 選択済みクラスを全て解除
                                            document.querySelectorAll('.block-tag').forEach(tag => 
                                                tag.classList.remove('selected')
                                            );
                                            // 現在のタグを選択状態にする
                                            blockTag.classList.add('selected');
                                            
                                            // 入力欄に値を設定（強化版）
                                            blockInputElement.value = block;
                                            blockInputElement.focus();
                                            
                                            // イベントを発火させて変更を検知させる
                                            const inputEvent = new Event('input', { bubbles: true });
                                            blockInputElement.dispatchEvent(inputEvent);
                                            
                                            const changeEvent = new Event('change', { bubbles: true });
                                            blockInputElement.dispatchEvent(changeEvent);
                                            
                                            console.log('ブロックタグがクリックされました:', block);
                                        });
                                        blockCandidateElement.appendChild(blockTag);
                                    });
                                    
                                    console.log('ブロック候補が表示されました: ', 
                                        summaryData.block, ' と類似ブロック ', similarBlocks.join(', '));
                                } else {
                                    console.warn('検出されたブロック名がありません');
                                }
                            } else {
                                console.error('ブロック候補表示時のエラー: DOM要素が見つかりません');
                            }
                            
                            // 7. 要約テキストを正しく表示する - ここが間違っていました
                            // 正しく設定：ブロック名はブロック欄に、要約は不具合内容欄に
                            document.getElementById('summary').value = summaryData.summary;
                            console.log('【重要】正しく設定 - ブロック名：', summaryData.block, ' / 要約：', summaryData.summary);
                            
                            // 8. 最後のチェックと再設定
                            setTimeout(() => {
                                // 全ての入力欄を再設定（確実に正しい値をセット）
                                // 1. ブロック名は必ずブロック入力欄に設定
                                document.getElementById('block-input').value = window.lastDetectedBlock;
                                
                                // 2. 要約は不具合内容欄に設定
                                if (summaryData.summary) {
                                    document.getElementById('summary').value = summaryData.summary;
                                }
                                
                                // 3. 確実に送信ボタンを有効化
                                if (submitButton) submitButton.disabled = false;
                                
                                console.log('【再設定完了】ブロック名=' + window.lastDetectedBlock + ' / 要約=' + summaryData.summary);
                            }, 500);
                        } catch (e) {
                            console.error('【重大エラー】ブロック名設定失敗:', e);
                            alert(`検出されたブロック名: ${summaryData.block} を手動で入力してください。`);
                        }
                    }
                } else {
                    console.warn('要約生成失敗 - 原文をそのまま使用します');
                    summary = transcript; // 要約なし
                }
            }
        } else {
            // 音声がない場合はテキストを直接入力してもらう
            const userText = prompt('レポート内容を入力してください:', '');
            if (!userText) {
                throw new Error('レポート内容が入力されていません');
            }
            transcript = userText;
            summary = userText; // 要約なし
        }

        // 画像アップロード処理
        let imageUrl = null;
        if (imageFile) {
            statusMessage.textContent = '処理中: 画像をアップロードしています...';
            
            // ファイル名の作成
            const currentDate = new Date();
            const dateStr = currentDate.toISOString().slice(0,10).replace(/-/g, "");
            const filename = `report_${dateStr}_ship${shipNO}_block${block}_${reporter}.jpg`;
            
            // Fileオブジェクトを作り直してファイル名を変更
            const renamedFile = new File([imageFile], filename, { type: imageFile.type });

            const imgForm = new FormData();
            imgForm.append("image", renamedFile);
            imgForm.append("reporter", reporter);
            imgForm.append("shipNO", shipNO);
            imgForm.append("block", block);

            try {
                const imageRes = await fetch("/api/upload-image-gas", { method: "POST", body: imgForm });
                if (imageRes.ok) {
                    const imageData = await imageRes.json();
                    if (imageData && imageData.imageUrl) {
                        imageUrl = imageData.imageUrl;
                        // グローバルスコープにも保存して確実に参照できるようにする
                        window.lastUploadedImageUrl = imageUrl;
                        console.log('画像アップロード成功:', imageUrl);
                    } else {
                        console.warn('画像アップロードは成功しましたが、URLが取得できませんでした');
                    }
                } else {
                    console.warn('画像アップロード失敗しましたが、処理を続行します');  
                }
            } catch (imgError) {
                console.warn('画像アップロードエラー:', imgError);
            }
        }
        
        // Google Sheetsにデータを送信
        statusMessage.textContent = '処理中: Google Sheetsに保存しています...';

        const currentDate = new Date();
        const formattedDate = currentDate.toISOString();
        
        // 画像URLをログ出力して確認
        console.log('画像URL確認（レポートデータ作成前）:', imageUrl);
        console.log('グローバル変数の画像URL:', window.lastUploadedImageUrl);

        // ローカル変数かグローバル変数から画像URLを取得
        const finalImageUrl = imageUrl || window.lastUploadedImageUrl || "";
        console.log('最終的な画像URL:', finalImageUrl);

        // レポートデータをサーバーが期待する形式に合わせる
        const reportData = {
            date: formattedDate,
            reporter,
            shipNO,
            blockName: block,
            content: summary,
            // 画像があれば画像URLを設定
            image_url: finalImageUrl
        };

        console.log('送信するレポートデータ:', reportData);
        const sheetsRes = await fetch("/api/save-to-sheets", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(reportData) // プロパティでラップせずに直接データを送信
        });
        
        if (!sheetsRes.ok) {
            throw new Error(`Google Sheetsへの保存エラー: ${sheetsRes.statusText}`);
        }
        
        const sheetsResult = await sheetsRes.json();
        console.log('Google Sheets保存結果:', sheetsResult);

        // 全てのプロセスが成功した場合
        statusMessage.textContent = '報告がスプレッドシートに送信されました';
        setTimeout(() => {
            alert('報告が正常に保存されました。');
            // 必要に応じてフォームをリセット
            resetForm();
        }, 1000);

    } catch (error) {
        console.error('エラー発生:', error);
        statusMessage.textContent = `エラーが発生しました: ${error.message}`;
        alert(`エラーが発生しました: ${error.message}`);
    } finally {
        // 状態に関わらずボタンを再度有効化
        submitButton.disabled = false;
        recordButton.disabled = false;
        imageInput.disabled = false;
        checkFormCompletion();
    }
}

// 送信ボタンのイベントリスナー
submitButton.addEventListener('click', () => {
    // 音声と画像は任意、責めない
    // テキストデータが最重要なので、手入力でも送信可能
    const reporter = reporterDisplay.textContent.trim();
    const shipNO = shipNOInput.value.trim();
    const block = blockInput.value.trim();

    if (!reporter || !shipNO || !block) {
        alert('報告者名、船体番号、ブロック名を入力してください。');
        return;
    }
    // shipNOInputはtype=textなのでパターンチェックが必要ならここで正規表現
    if (!/^[0-9]{3}$/.test(shipNO)) {
        alert('船体番号は半角数字3桁で入力してください。');
        return;
    }

    processAndSendReport(audioBlob, imageFile, reporter, shipNO, block);
});

// フォームリセット関数
function resetForm() {
    // reporterDisplayはdivなので空文字
    reporterDisplay.textContent = '';
    shipNOInput.value = '';
    blockInput.value = '';
    imageInput.value = ''; // ファイル選択をリセット
    imagePreview.style.display = 'none';
    imagePreview.src = '#';
    recordingStatus.textContent = '停止中';
    recordButton.textContent = '録音開始';
    if(statusMessage) statusMessage.textContent = '';
    audioBlob = null;
    imageFile = null;
    isRecording = false;
    submitButton.disabled = true; // リセット後は送信不可
}

// 初期状態では送信ボタンを無効化
checkFormCompletion();
