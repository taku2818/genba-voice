import express from "express";
import multer from "multer";
import cors from "cors";
import dotenv from "dotenv";
import OpenAI from "openai";
import fs from "fs";
import path from "path";
import { fileURLToPath } from "url";
import FormData from "form-data";
import axios from "axios";

// ESモジュールでの __dirname 相当の実装
const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

dotenv.config();
const app = express();
const port = process.env.PORT || 3001;

// Multerの設定 - 拡張子を正しく設定
const storage = multer.diskStorage({
  destination: function (req, file, cb) {
    cb(null, path.join(__dirname, "../uploads/"))
  },
  filename: function (req, file, cb) {
    // 拡張子を.webmに指定して保存
    const timestamp = Date.now();
    cb(null, `audio-${timestamp}.webm`)
  }
});

const upload = multer({ storage: storage });

// 画像アップロード用の一時保存設定
const imageUpload = multer({ dest: 'uploads/' });

// ミドルウェア
app.use(cors());
app.use(express.json());
app.use(express.static(path.join(__dirname, '../public')));

// OpenAI設定 - v4 スタイル
const openai = new OpenAI({
  apiKey: process.env.OPENAI_API_KEY,
});

// Google Drive画像アップロード用のGAS API URL
const GAS_IMAGE_UPLOAD_URL = process.env.GAS_IMAGE_UPLOAD_URL;
// Google Sheets保存用のGAS API URL
const GAS_SHEETS_SAVE_URL = process.env.GAS_SHEETS_SAVE_URL;

// デバッグ用ログ出力
console.log('Google Sheets API URL:', GAS_SHEETS_SAVE_URL);
console.log('GAS API URL (Drive):', GAS_IMAGE_UPLOAD_URL);

// 画像アップロードAPI（GAS連携）
app.post('/api/upload-image-gas', imageUpload.single('image'), async (req, res) => {
  console.log('【デバッグ】/api/upload-image-gas - リクエスト受信');
  console.log('【デバッグ】req.body:', req.body);
  console.log('【デバッグ】req.file:', req.file ? '存在します' : '存在しません');
  
  try {
    if (!req.file) {
      console.log('【デバッグ】画像ファイルがありません');
      return res.json({ success: true, imageUrl: null });
    }

    console.log('【デバッグ】画像ファイル情報:', {
      filename: req.file.originalname,
      path: req.file.path,
      size: req.file.size,
      mimetype: req.file.mimetype
    });
    
    const reporter = req.body.reporter || "unknown";
    const shipNO = req.body.shipNO || "000";
    const block = req.body.block || "unknown";
    const date = new Date().toISOString().slice(0, 10).replace(/-/g, "");
    const targetFilename = `report_${date}_ship${shipNO}_block${block}_${reporter}.jpg`;
    
    console.log('【デバッグ】ターゲットファイル名:', targetFilename);

    const filePath = req.file.path;
    // ファイルを読み込み、正しい形式でbase64エンコード
    const fileBuffer = fs.readFileSync(filePath);
    // シンプルなbase64エンコードに戻す
    const base64Image = Buffer.from(fileBuffer).toString('base64');
    console.log('【デバッグ】base64エンコード完了 - サイズ:', base64Image.length, 'バイト');
    // base64文字列のプレビューを表示（MIME型付き）
    console.log('【デバッグ】base64プレビュー:', base64Image.substring(0, 100) + '...');
    console.log('【デバッグ】GAS画像アップロードURL:', GAS_IMAGE_UPLOAD_URL);

    // GASが期待する形式でデータを送信する
    // GASが期待する形式に合わせて送信する
    // URLクエリパラメータでfilenameを送り、リクエストボディに画像データを直接送る
    const url = `${GAS_IMAGE_UPLOAD_URL}?filename=${encodeURIComponent(targetFilename)}`;
    
    const response = await axios.post(url, base64Image, {
      headers: {
        'Content-Type': 'text/plain'
      }
    });
    
    console.log('【デバッグ】GASレスポンス:', response.data);

    // GASからのレスポンスに予期する画像URLがあるか確認
    // 通常は imageUrl だが、必要に応じて fileUrl や他の可能性も確認
    let imageUrl = null;
    if (response.data && response.data.success) {
      // プロパティ名の優先順位
      imageUrl = response.data.imageUrl || response.data.fileUrl || response.data.url || response.data.link;
      
      // ログ出力して確認
      console.log('【デバッグ】最終的な画像URL:', imageUrl);
    }
    
    fs.unlinkSync(filePath);
    // 最終的なURLをクライアントに送信
    res.json({ 
      success: true, 
      imageUrl: imageUrl,
      // 元のレスポンスも全て追加しておく
      ...response.data 
    });

  } catch (err) {
    console.error('【デバッグ】画像アップロードエラー:', err.message);
    if (err.response) {
      console.error('【デバッグ】GASエラーレスポンス:', err.response.data);
    }
    res.status(500).json({ success: false, error: err.message });
  }
});

// GPT 要約＆ブロック名推定 API エンドポイント
app.post("/api/summarize", async (req, res) => {
  console.log('【デバッグ】要約リクエスト:', req.body);  // デバッグ出力追加
  const { text, blocks } = req.body; // ブロック名リストをリクエストから取得
  if (!text) {
    return res.status(400).json({ error: "要約対象のテキストが必要です" });
  }

  // 受け取ったブロック名リストを確認する
  console.log('【重要】受け取ったブロックリスト:', blocks ? blocks.length + '個' : 'なし');
  if (blocks && blocks.length > 0) {
    console.log('ブロックリストサンプル:', blocks.slice(0, 5), '...', blocks.slice(-5));
    console.log('S5が含まれているか確認:', blocks.includes('S5') ? '含まれている✅' : '含まれていない❌');
  }
  
  // ここで完全なブロックリストを定義 - クライアントからのリストが不完全な場合のバックアップ
  const COMPLETE_BLOCK_LIST = [
    "BAA", "BOA", "BAF", "BOF", "B1", "B2", "B3", "B4", "B5", "B6", "B7", "B8", "B9", "B10", "B11", "B12",
    "SA1", "SA1A", "SA1F", "SA2", "SA2C", "SA3", "SA3C",
    "AP1", "AP2",
    "AHA", "AHF", "AH", "AH2", "AH3", "AH4", "AH5", "AH6",
    "AH2A", "AH3A", "AH4A", "AH5A", "AH6A",
    "AH2F", "AH3F", "AH4F", "AH5F", "AH6F",
    "L1", "L2", "L3", "L4", "L5", "L6", "L7", "L8", "L9", "L10", "L11", "L12", "L13",
    "S1", "S2", "S3", "S4", "S5", "S6", "S7", "S8", "S9", "S10", "S11", "S12", "S13",
    "D1", "D2", "D3", "D4", "D5", "D6", "D7", "D8", "D9", "D10", "D11", "D12", "D13",
    "DC1", "DC2", "DC3", "DC4", "DC5", "DC6", "DC7", "DC8", "DC9", "DC10", "DC11", "DC12", "DC13",
    "FP1", "FP2", "FP3", "FP4",
    "BF", "FH", "BC", "BUL1", "BUL2"
  ];
  
  // クライアントからのリストをチェックし、S系ブロックが含まれていない場合は完全なリストを使用
  let blockNames = blocks || [];
  
  // ブロックリストに問題がある場合は完全なリストを使用
  if (!blockNames.includes('S5') || !blockNames.includes('S13') || blockNames.length < 50) {
    console.log('【警告】不完全なブロックリストを完全なリストで置き換えます');
    blockNames = COMPLETE_BLOCK_LIST;
  }

  // JSON出力を求める指示を追加
  const prompt = `あなたは建設現場の報告書を要約するAIアシスタントです。次の音声文字起こしから、ブロック名と不具合内容を抽出して構造化してください。

音声文字起こし:
${text}

利用可能なブロックリスト:
${blockNames.join(", ")}

指示:
1. ブロック名と不具合内容を明確に分割して抜き出してください
2. ブロック名は「利用可能なブロックリスト」にある候補から選択してください
3. 例えば「ブロック名はS8」という文があれば、blockNameを"S8"、その後の内容をsummaryに入れてください
4. ブロック名が表現されていない場合もその他の情報から推定してください
5. 不具合内容の書き出しにはブロック名を含めないでください

以下の正確なJSON形式で応答してください:
{"blockName": "抽出したブロック名（リストにあるもの、なければ空文字）", "summary": "ブロック名を含まない不具合内容の要約"}
`;
  
  console.log('【デバッグ】要約プロンプト:', prompt);

  try {
    const completion = await openai.chat.completions.create({
      model: "gpt-3.5-turbo",
      messages: [
        { role: "system", content: "あなたは報告書を処理する専門AIです。常に指定された形式で回答してください。" },
        { role: "user", content: prompt }
      ],
      temperature: 0.5,
    });

    console.log('【デバッグ】GPTレスポンス:', completion.choices[0].message.content);
    
    try {
      // JSON部分を抽出して解析
      const content = completion.choices[0].message.content;
      console.log('【デバッグ】AIの完全な回答:', content);
      
      // JSONパースを試みる
      try {
        // JSON部分を抽出して解析
        const jsonMatch = content.match(/\{[\s\S]*\}/);
        let result;
        
        if (jsonMatch) {
          result = JSON.parse(jsonMatch[0]);
          console.log('【デバッグ】解析されたJSON:', result);
          
          // サーバーからクライアントへの互換性を確保
          // クライアントが予期するプロパティ名を変換する
          res.json({
            blockName: result.blockName || '',
            summary: result.summary || ''
          });
        } else {
          // JSONが見つからない場合はエラー
          throw new Error("AIの応答からJSONを抽出できませんでした");
        }
      } catch (parseError) {
        console.error('【デバッグ】JSONパースエラー:', parseError);
        // エラー時は簡易的な処理を実施
        res.json({ 
          blockName: '',
          summary: content.substring(0, 500) // 応答の先頭500文字を要約として使用
        });
      }
    } catch (error) {
      console.error('【デバッグ】完全なエラー:', error);
      res.json({ 
        blockName: '',
        summary: completion.choices[0].message.content.substring(0, 500)
      });
    }

  } catch (error) {
    console.error('【デバッグ】GPT APIエラー:', error);
    res.status(500).json({ error: "GPT APIエラー", message: error.message });
  }
});

// Google Sheets保存APIエンドポイント（GAS連携）
app.post("/api/save-to-sheets", async (req, res) => {
  console.log('【デバッグ】/api/save-to-sheets - リクエストデータ（生）:', req.body);
  console.log('【デバッグ】/api/save-to-sheets - リクエストデータ（JSON）:', JSON.stringify(req.body));
  const reportData = req.body;
  console.log('【デバッグ】image_urlを確認:', reportData.image_url);
  
  if (!reportData.date || !reportData.reporter || !reportData.shipNO || !reportData.blockName || !reportData.content) {
    console.log('【デバッグ】/api/save-to-sheets - 必須項目不足:', reportData);
    return res.status(400).json({ success: false, error: "必須項目が不足しています。" });
  }

  try {
    console.log('【デバッグ】GAS URL:', GAS_SHEETS_SAVE_URL);
    
    // GASが期待するフィールド名に変換
    const gasData = {
      date: reportData.date,
      reporter: reportData.reporter,
      ship_no: reportData.shipNO,  // shipNO -> ship_no
      block: reportData.blockName, // blockName -> block
      content: reportData.content,
      image_url: reportData.image_url
    };
    
    console.log('【デバッグ】送信するデータ(変換後):', gasData);
    const response = await axios.post(GAS_SHEETS_SAVE_URL, gasData);
    console.log('【デバッグ】GASレスポンス:', response.data);
    res.json({ success: true, message: "スプレッドシートに保存されました" });
  } catch (error) {
    console.error('【デバッグ】GASエラー:', error.message);
    if (error.response) {
      console.error('【デバッグ】GASエラーレスポンス:', error.response.data);
    }
    res.status(500).json({ success: false, error: "スプレッドシート保存エラー" });
  }
});

// Whisper API エンドポイント
app.post("/api/whisper", upload.single("audio"), async (req, res) => {
  try {
    if (!req.file) {
      return res.status(400).json({ error: "音声ファイルがアップロードされていません" });
    }

    console.log("ファイル情報:", req.file);
    console.log("APIキー確認: ", process.env.OPENAI_API_KEY ? "APIキーが設定されています" : "APIキーが設定されていません");
    
    if (!process.env.OPENAI_API_KEY) {
      return res.status(500).json({ error: "OpenAI APIキーが設定されていません" });
    }

    try {
      // 何もしない - エラー修正のために整理
      
      // API呼び出しの準備
      console.log("Whisper API呼び出し準備中...");
      console.log("APIキーの最初の5文字:", process.env.OPENAI_API_KEY.substring(0, 5));
      console.log("ファイルパス:", req.file.path);
      
      // ファイル情報の詳細表示
      let fileStats = null;
      try {
        fileStats = fs.statSync(req.file.path);
        console.log(`ファイル存在確認: 存在します`);
        console.log(`ファイルサイズ: ${fileStats.size} bytes`);
      } catch (error) {
        console.error('ファイル情報取得エラー:', error);
        return res.status(400).json({ error: 'ファイル情報の取得に失敗しました' });
      }
      
      // 空のファイルが送信された場合はテストモードで動作
      if (fileStats.size === 0) {
        console.log("空のファイルがアップロードされました - テストモードで動作します");
        
        // 処理後にファイルを削除
        fs.unlink(req.file.path, (err) => {
          if (err) console.error("ファイル削除エラー:", err);
        });
        
        // テストモードのレスポンスを返す
        const mockTranscript = "ブロック名はB5です。配管のサポートが外れており、接続部が破損しています。修理が必要です。";
        console.log("テストモード文字起こし:", mockTranscript);
        return res.json({ transcript: mockTranscript });
      }
      
      try {
        // デバッグモードの場合は、実際のAPI呼び出しをスキップしてモックレスポンスを返す
        if (process.env.DEBUG_MODE) {
          console.log("[デバッグモード] API呼び出しをスキップしてモック応答を返します");
          console.log("ファイルパス:", req.file.path);
          
          try {
            // 処理後にファイルを削除
            fs.unlink(req.file.path, (err) => {
              if (err) console.error("ファイル削除エラー:", err);
            });
            
            // デバッグモードのモックレスポンス - より自然な文章に変更
            const debugTranscript = "ブロック名はB5です。配管のサポート部分が外れており、接続部に不具合が発生しています。修理をお願いします。";
            console.log("デバッグモードのレスポンス:", { transcript: debugTranscript });
            return res.json({ transcript: debugTranscript });
          } catch (innerErr) {
            console.error("デバッグモードエラー:", innerErr);
            return res.json({ transcript: "デバッグモードエラーが発生しましたが、処理を継続します。" });
          }
        }
        
        // 実際のAPI呼び出し
        console.log("Whisper API呼び出し準備中...");
        
        // リクエスト準備 - FormDataは不要になりました（OpenAI SDKが内部で処理）
        console.log("リクエスト準備完了 - 送信開始");
        
        // OpenAI API v4向けのファイル送信方法
        const transcription = await openai.audio.transcriptions.create({
          file: fs.createReadStream(req.file.path),
          model: 'whisper-1',
          language: 'ja'
        });
        
        console.log("文字起こし成功:", transcription.text);
        
        // 処理後にファイルを削除
        fs.unlink(req.file.path, (err) => {
          if (err) console.error("ファイル削除エラー:", err);
        });
    
        res.json({ transcript: transcription.text });
      } catch (whisperErr) {
        console.error("エラー発生:", whisperErr);
        if (whisperErr.response) {
          console.error("レスポンスデータ:", whisperErr.response.data);
          console.error("ステータスコード:", whisperErr.response.status);
          console.error("ヘッダー:", whisperErr.response.headers);
        } else if (whisperErr.request) {
          console.error("リクエスト情報:", "(リクエストは送信されましたが、レスポンスは受信されませんでした)");
        } else {
          console.error("エラー詳細:", whisperErr.message);
        }
        
        // ファイルを削除
        fs.unlink(req.file.path, (err) => {
          if (err) console.error("ファイル削除エラー:", err);
        });
        
        // デバッグモードならモックレスポンスを返す
        if (process.env.DEBUG_MODE) {
          console.log("エラー発生時のフォールバック: デバッグモードでモックレスポンスを返します");
          const fallbackTranscript = "エラー発生時のフォールバック応答です。ブロック名はB5で、エラーが発生しましたがテストモードで継続します。";
          return res.json({ transcript: fallbackTranscript });
        }
        
        // デバッグモードでない場合は通常のエラーレスポンス
        throw whisperErr;
      }
    } catch (apiError) {
      console.error("OpenAI APIエラー詳細:", apiError.response ? apiError.response.data : apiError.message);
      res.status(500).json({ error: "Whisper APIエラー: " + (apiError.response ? JSON.stringify(apiError.response.data) : apiError.message) });
    }
  } catch (err) {
    console.error("Whisperエラー全体:", err);
    res.status(500).json({ error: "Whisper変換失敗" });
  }
});

// デバッグレポートエンドポイント - 常に成功を返すテスト用
app.post("/api/save-report", async (req, res) => {
  try {
    console.log('\n============ /api/save-report 呼び出しを受信しました ============');
    console.log('リクエストボディ:', JSON.stringify(req.body, null, 2));
    
    // デバッグモードでは常に成功レスポンスを返す
    console.log('デバッグモード: 常に成功レスポンスを返します');
    
    // 実際の保存処理を記録するログファイル作成
    const logDir = path.join(__dirname, "../logs");
    if (!fs.existsSync(logDir)) {
      fs.mkdirSync(logDir, { recursive: true });
    }
    
    const logFilePath = path.join(logDir, `report_log_${Date.now()}.json`);
    fs.writeFileSync(logFilePath, JSON.stringify(req.body, null, 2));
    console.log(`レポートデータをログに保存しました: ${logFilePath}`);
    
    // デバッグ用成功レスポンス
    return res.json({ 
      success: true, 
      message: "[デバッグモード] レポートがログファイルに保存されました。",
      debug: true,
      logPath: logFilePath
    });
  } catch (error) {
    console.error('エラー発生:', error);
    return res.json({ success: true, message: 'エラーが発生しましたが、デバッグモードで成功を返します', error: error.message });
  }
});

// 最近の船体番号を取得するAPIエンドポイント（固定リスト版）
app.get("/api/recent-ships", async (req, res) => {
  try {
    // デフォルトの船体番号リスト
    const recentShips = ["345", "346", "347"];
    res.json({ ships: recentShips });
  } catch (error) {
    console.error('船体番号取得エラー:', error);
    res.status(500).json({ error: '船体番号の取得に失敗しました', ships: ["345", "346", "347"] });
  }
});

